<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	  <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>Ama.Enterprise.P2p.WebRTC</PackageId>
		<Version>0.0.0</Version>
		<Authors>Alexander Mantzoukas</Authors>
		<Description>WebRTC transport implementation for peer-to-peer gossip meshes natively supporting STUN/TURN.</Description>
		<RepositoryUrl>https://github.com/phaetto/Ama.Enterprise</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>Proprietary</PackageLicenseExpression>
		<PackageTags>p2p;webrtc;gossip;distributed-systems;networking;transport</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- SourceLink and Symbol Configuration -->
		<PublishRepositoryUrl>false</PublishRepositoryUrl>
		<EmbedUntrackedSources>false</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- Generate XML documentation file -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Suppress warning for missing comments on internal/private members -->
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ama.Enterprise.P2p\Ama.Enterprise.P2p.csproj" />
  </ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ama.Enterprise.Project.Analyzers\Ama.Enterprise.Project.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>