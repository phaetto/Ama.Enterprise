<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>Ama.Enterprise.CRDT.Testing</PackageId>
		<Version>0.0.0</Version>
		<Authors>Alexander Mantzoukas</Authors>
		<Description>Shared testing utilities and infrastructure for Ama.Enterprise.CRDT components.</Description>
		<RepositoryUrl>https://github.com/phaetto/Ama.Enterprise</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>crdt;testing;xunit</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- SourceLink and Symbol Configuration -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- Generate XML documentation file -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Suppress warning for missing comments on internal/private members -->
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ama.Enterprise.Project.Analyzers\Ama.Enterprise.Project.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>