<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>Ama.Enterprise.P2p.AspNetCore</PackageId>
		<Version>0.0.0</Version>
		<Authors>Alexander Mantzoukas</Authors>
		<Description>ASP.NET Core integration for the Ama.Enterprise P2P Mesh, natively mapping generic inbound HTTP payloads and handling localized Kestrel endpoint transports dynamically sharing web host boundaries.</Description>
		<RepositoryUrl>https://github.com/phaetto/Ama.Enterprise</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>p2p;aspnetcore;minimal-api;gossip;distributed-systems;networking;transport</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- SourceLink and Symbol Configuration -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- Generate XML documentation file -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Suppress warning for missing comments on internal/private members -->
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ama.Enterprise.P2p\Ama.Enterprise.P2p.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ama.Enterprise.Project.Analyzers\Ama.Enterprise.Project.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>