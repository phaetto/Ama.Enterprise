<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>Ama.Enterprise.FeatureFlags</PackageId>
		<Version>0.0.0</Version>
		<Authors>Alexander Mantzoukas</Authors>
		<Description>Decentralized feature flags synchronization across peer-to-peer meshes using CRDTs.</Description>
		<RepositoryUrl>https://github.com/phaetto/Ama.Enterprise</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>Proprietary</PackageLicenseExpression>
		<PackageTags>feature=flags;crdt;p2p;gossip;distributed-systems;collaboration;conflict-free</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- SourceLink and Symbol Configuration -->
		<PublishRepositoryUrl>false</PublishRepositoryUrl>
		<EmbedUntrackedSources>false</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- Generate XML documentation file -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Suppress warning for missing comments on internal/private members -->
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Ama.CRDT" Version="3.2.260424-ci1733" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ama.Enterprise.CRDT.Distributed\Ama.Enterprise.CRDT.Distributed.csproj" />
		<ProjectReference Include="..\Ama.Enterprise.P2p.WebRTC\Ama.Enterprise.P2p.WebRTC.csproj" />
		<ProjectReference Include="..\Ama.Enterprise.P2p\Ama.Enterprise.P2p.csproj" />
		<ProjectReference Include="..\Ama.Enterprise.Project.Analyzers\Ama.Enterprise.Project.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>